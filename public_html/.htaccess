RewriteEngine On

# Browser tab icon follows the favicon saved in Branding.
RewriteRule ^favicon\.ico$ favicon.php [L]

# Home and story pages. Do not send visitors to Node.
RewriteRule ^news/([^/]+)/?$ news/index.php?url=$1 [L,QSA]
RewriteRule ^category/([^/]+)/?$ category/index.php?url=$1 [L,QSA]
RewriteRule ^latest/?$ latest.php [L,QSA]
RewriteRule ^author/([0-9]+)/?$ author.php?id=$1 [L,QSA]
RewriteRule ^page/([^/]+)/?$ page/index.php?url=$1 [L,QSA]
RewriteRule ^install/?$ install.php [L,QSA]
